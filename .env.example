# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional — Gemini model id used for search/analysis/pitches.
# Default: "gemini-flash-latest" (auto-updates to the newest stable Flash).
# Pode usar um nome fixo (ex: gemini-3.5-flash, gemini-3.6-flash, gemini-3.7-flash).
GEMINI_MODEL="gemini-flash-latest"

# SERPAPI_API_KEY: Optional — SerpAPI Google Maps (real, sem invenção). Free: 250/mês, 50/hora.
# Gere em https://serpapi.com/users/sign_up — sem cartão. Renova no 1º do mês (ciclo mensal) e janela horária deslizante.
# Apenas buscas com sucesso contam; cache (1h) e erros não consomem.
SERPAPI_API_KEY="MY_SERPAPI_KEY"
# SERPAPI_SEARCHES_PER_MONTH: override do limite mensal (default 250 free)
# SERPAPI_SEARCHES_PER_MONTH="250"
# SERPAPI_THROUGHPUT_PER_HOUR: override do limite horário (default 50 free)
# SERPAPI_THROUGHPUT_PER_HOUR="50"
# PROSPECTING_PROVIDER: "serpapi" (default se SERPAPI_API_KEY setado) ou "gemini"
# PROSPECTING_PROVIDER="serpapi"
# SERPAPI_CACHE_TTL_HOURS: TTL do cache local de buscas SerpAPI em horas (default 168 = 7 dias).
# Buscas idênticas dentro do TTL não consomem cota.
# SERPAPI_CACHE_TTL_HOURS="168"
#
# RESEARCH_STALE_DAYS: idade (em dias) a partir da qual o cache de uma busca é
# ignorado para permitir re-descoberta de empresas novas na mesma cidade
# (default 60). 0 desativa a re-busca automática.
# RESEARCH_STALE_DAYS="60"
#
# ---------------------------------------------------------------------
# ROTAÇÃO DE CIDADES (base IBGE 5.571 municípios + round-robin)
# Parâmetros do agendamento batch_prospecting (payload do schedule):
#   useCityRotation: true → pega as próximas cidades há mais tempo sem buscar
#   citiesPerRun: cidades por disparo (default 3)
#   uf, minPopulation, maxPopulation: filtros geográficos (default 30k–200k hab)
#   minPropensity: descarta categorias com propensão menor que este valor (0–100)
# Esses valores são configurados na UI/schedule, não via .env.

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Places / Business Profile enrichment.
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_KEY"

# HUNTER_API_KEY: Optional — for e-mail enrichment via Hunter.io (free tier: 25/mo).
HUNTER_API_KEY="MY_HUNTER_API_KEY"

# NETLIFY_AUTH_TOKEN: Optional — for deploying Landing Pages to Netlify Drop.
# Generate at https://app.netlify.com/user/applications → Personal Access Tokens
NETLIFY_AUTH_TOKEN="MY_NETLIFY_TOKEN"

# NETLIFY_SITE_ID: Optional — existing Netlify site to redeploy. If omitted, creates a new site per deploy.
NETLIFY_SITE_ID=""

# =====================================================================
# TYPEFORM — BRIEFING DE CLIENTES (Responses API)
# =====================================================================
# TYPEFORM_ACCESS_TOKEN: Required to import client briefings from Typeform.
# Generate at https://admin.typeform.com/ → Integrations → Personal access tokens.
TYPEFORM_ACCESS_TOKEN="MY_TYPEFORM_ACCESS_TOKEN"
# TYPEFORM_FORM_ID: ID of the briefing form (the slug in its URL: https://form.typeform.com/to/<FORM_ID>).

TYPEFORM_FORM_ID=""

# TYPEFORM_SYNC_INTERVAL_MIN: minutes between automatic briefing imports (default 5; 0 disables polling).

# TYPEFORM_SYNC_INTERVAL_MIN=5

# =====================================================================
# CANAIS DE CONTATO (enviar mensagens reais aos leads)
# =====================================================================
# --- WhatsApp via Evolution API (self-hosted, gratuito) — RECOMENDADO ---
# 1. Suba a Evolution API (docker-compose.evolution.yml no projeto) e escaneie o QR Code
# 2. Preencha as três variáveis abaixo
# EVOLUTION_API_URL: URL base da sua instância (ex: http://localhost:8080)
# EVOLUTION_API_KEY: a mesma AUTHENTICATION_API_KEY definida no docker-compose
# EVOLUTION_INSTANCE: nome da instância (default "leadradar")
# EVOLUTION_API_URL=""
# EVOLUTION_API_KEY=""
# EVOLUTION_INSTANCE="leadradar"
#
# WHATSAPP_WEBHOOK_TOKEN: protege /api/whatsapp/webhook (opcional, recomendado
# se o servidor estiver exposto à internet). Configure o mesmo valor como
# query param ?token=... na URL do webhook da Evolution.
# WHATSAPP_WEBHOOK_TOKEN=""
#
# --- Webhook genérico legado (Z-API, n8n, etc.) — fallback ---
# Usado apenas se EVOLUTION_API_URL não estiver configurada.
# Espera POST { token: WHATSAPP_API_TOKEN, to, message }.
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# SMTP settings for real email dispatch via nodemailer.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LeadRadar AI <no-reply@example.com>"

# JOB_WEBHOOK_URL: Optional — POSTs a job summary to this URL when a job finishes.
JOB_WEBHOOK_URL=""

# MCP_API_TOKEN: Optional — require Authorization: Bearer <token> (or ?token=) on /api/mcp/*.
MCP_API_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =====================================================================
# AGENDADOR DE PROSPECÇÃO PERIÓDICA (Fase 2 do roadmap)
# =====================================================================
# LEADRADAR_SCHEDULER: "on" (default) ou "off" para desligar o agendador in-process.
LEADRADAR_SCHEDULER="on"

# LEADRADAR_MAX_LPS_PER_DAY: guardrail de autonomia — máx. de Landing Pages criadas por dia (default 5).
LEADRADAR_MAX_LPS_PER_DAY="5"

# LEADRADAR_MAX_LEADS_PER_RUN: limite de leads processados por execução do autopilot agendado (default 5).
LEADRADAR_MAX_LEADS_PER_RUN="5"

